# =====================================================================
# ChatApp Backend Environment Configuration Template
# =====================================================================
# Copy this file to .env and provide your production / environment values.

# ── 1. Server Configuration ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── 2. CORS Allowlist ────────────────────────────────────────────────
# Set to your deployed frontend URL (or comma-separated URLs)
# E.g.: https://your-frontend.vercel.app,https://your-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# ── 3. MongoDB Database Connection ────────────────────────────────────
# MongoDB Atlas connection string (or local mongodb://localhost:27017/chatapp)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatapp?retryWrites=true&w=majority

# ── 4. JWT Authentication ─────────────────────────────────────────────
# Required in production: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=30d

# ── 5. Firebase Authentication ────────────────────────────────────────
# Required for Firebase Google Sign-In verification on backend
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_web_api_key

# ── 6. Google OAuth (Optional direct OAuth fallback) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── 7. Cloudinary Cloud Storage (Optional for persistent uploads) ─────
# If left blank, file uploads are stored locally in backend/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 8. LiveKit SFU (Voice & Video Calls) ──────────────────────────────
# Obtain credentials from https://cloud.livekit.io
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
